---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Gallery from '../../components/Gallery.astro';
import DownloadButtons from '../../components/DownloadButtons.astro';
import BookCard from '../../components/BookCard.astro';

export async function getStaticPaths() {
  const booksEntries = await getCollection('books');
  return booksEntries.map(entry => ({
    params: { slug: entry.id },
    props: { book: entry, allBooks: booksEntries },
  }));
}

const { book, allBooks } = Astro.props;
const { Content } = await render(book);
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const homeUrl = import.meta.env.BASE_URL;

const seriesBooks = book.data.series
  ? allBooks.filter(b => b.data.series === book.data.series && b.id !== book.id).sort((a, b) => (a.data.seriesOrder || 0) - (b.data.seriesOrder || 0))
  : [];

const seriesCountText = seriesBooks.length === 1
  ? 'книга'
  : (seriesBooks.length === 2 || seriesBooks.length === 3 || seriesBooks.length === 4)
    ? 'книги'
    : 'книг';
---

<Layout 
  title={`${book.data.title} — ${book.data.author}`} 
  description={`Скачать иллюстрированное издание книги «${book.data.title}» автора ${book.data.author} в форматах EPUB (Цветной и Ч/Б).`}
  ogImage={book.data.coverImage.src}
>
  <a href={homeUrl} class="type-ui mb-6 inline-flex text-xs font-black uppercase tracking-[0.26em] text-muted transition-colors hover:text-accent">
    ← Назад к каталогу
  </a>

  <article class="reveal-print mx-auto w-full max-w-[1800px]">
    <div class="grid items-start gap-8 xl:grid-cols-[minmax(280px,360px)_minmax(0,920px)_minmax(360px,420px)]">
      <section class="flex min-w-0 flex-col">
        <button
          type="button"
          class="group aspect-[2/3] w-full cursor-zoom-in overflow-hidden rounded-xl border border-white/10 bg-paper-alt p-3 shadow-2xl shadow-black/40"
          data-lightbox-src={book.data.coverImage.src}
          aria-label={`Увеличить обложку: ${book.data.title}`}
        >
          <Image
            src={book.data.coverImage}
            alt={`Обложка: ${book.data.title}`}
            width={720}
            height={1080}
            format="webp"
            class="h-full w-full rounded-lg object-cover transition-all duration-700 group-hover:scale-[1.02] group-hover:brightness-110"
          />
        </button>

        <div class="mt-5 rounded-xl border border-accent/20 bg-[linear-gradient(145deg,rgba(255,255,255,0.1),rgba(23,23,23,0.85)_48%,rgba(176,138,69,0.15))] p-5 shadow-xl shadow-black/30 ring-1 ring-white/10 sm:backdrop-blur-md text-center">
          <p class="type-ui text-xs font-black uppercase tracking-[0.24em] text-accent">
            {book.data.series ? `${book.data.series}${book.data.seriesOrder ? ` #${book.data.seriesOrder}` : ''}` : 'Вне серии'}
          </p>
          <h1 class="mt-3 text-2xl font-bold leading-tight tracking-tight text-ink sm:text-3xl">
            {book.data.title}
          </h1>
          <p class="type-ui mt-4 text-xs font-black uppercase tracking-[0.22em] text-muted">
            {book.data.author}
          </p>
        </div>
      </section>

      <section class="flex min-w-0 flex-col">
        <div class="relative flex flex-col justify-between overflow-hidden rounded-xl border border-accent/25 bg-[radial-gradient(circle_at_18%_0%,rgba(228,213,183,0.16),transparent_34%),linear-gradient(145deg,rgba(255,255,255,0.15),rgba(23,23,23,0.85)_42%,rgba(176,138,69,0.15))] p-8 shadow-2xl shadow-black/45 ring-1 ring-white/10 sm:backdrop-blur-md sm:p-10">

          <h2 class="type-ui mb-6 text-center text-base font-black uppercase tracking-[0.24em] text-accent">Описание книги</h2>

          <div class="book-description max-w-none text-justify text-lg leading-relaxed [&_strong]:text-accent sm:text-xl">
            <Content />
          </div>

          <p class="mt-8 text-center text-lg font-semibold italic text-accent underline decoration-accent/40 underline-offset-4 sm:text-xl">
            Данное издание содержит уникальные иллюстрации сюжета.
          </p>

          <h2 class="type-ui mt-10 mb-6 text-center text-base font-black uppercase tracking-[0.24em] text-accent">Рекомендации по скачиванию</h2>

          <div class="space-y-3 text-lg leading-relaxed sm:text-xl">
            <p><strong class="text-accent">Цветная версия</strong>: рекомендуется для чтения на смартфонах, планшетах (iPad, Android) и экранах компьютеров.</p>
            <p><strong class="text-accent">Ч/Б версия</strong>: специально оптимизирована для электронных книг с экранами E-Ink (Amazon Kindle, PocketBook, Onyx Boox) для идеального контраста.</p>
          </div>

          <div class="mt-10 border-t border-accent/35 pt-8">
            <h2 class="type-ui mb-6 text-center text-base font-black uppercase tracking-[0.24em] text-accent">Скачать издание</h2>
            <DownloadButtons colorEpub={book.data.colorEpub} bwEpub={book.data.bwEpub} />
          </div>
        </div>
      </section>

      <section class="flex min-w-0 flex-col">
        <div class="flex rounded-xl border border-white/[0.14] bg-[linear-gradient(145deg,rgba(255,255,255,0.1),rgba(23,23,23,0.85)_44%,rgba(228,213,183,0.08))] p-3 shadow-2xl shadow-black/35 sm:backdrop-blur-md">
          <Gallery images={book.data.exampleImages} hideHeader />
        </div>

        {seriesBooks.length > 0 && (
          <div class="mt-5 rounded-xl border border-accent/20 bg-[linear-gradient(145deg,rgba(255,255,255,0.1),rgba(23,23,23,0.85)_48%,rgba(176,138,69,0.15))] p-5 shadow-xl shadow-black/30 ring-1 ring-white/10 sm:backdrop-blur-md">
            <h3 class="type-ui mb-3 text-center text-xs font-black uppercase tracking-[0.24em] text-accent">Серия «{book.data.series}»</h3>
            <a href="#series-block" class="group/btn flex w-full items-center justify-center gap-2 rounded-lg border border-accent/30 bg-accent/10 px-4 py-3 text-sm font-bold text-accent transition-all hover:border-accent/50 hover:bg-accent/20 hover:text-white">
              <span>Смотреть ещё {seriesBooks.length} {seriesCountText}</span>
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 transition-transform group-hover/btn:translate-y-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
              </svg>
            </a>
          </div>
        )}
      </section>
    </div>

    {seriesBooks.length > 0 && (
      <section id="series-block" class="mt-16 border-t border-white/5 pt-10 scroll-mt-24">
        <h2 class="text-xl md:text-2xl font-bold mb-8">В серии «{book.data.series}»</h2>
        <div class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-6 gap-4 sm:gap-6">
          {seriesBooks.map((b) => (
            <BookCard
              title={b.data.title}
              author={b.data.author}
              coverImage={b.data.coverImage}
              slug={b.id}
              series={b.data.series}
              seriesOrder={b.data.seriesOrder}
            />
          ))}
        </div>
      </section>
    )}
  </article>
</Layout>
