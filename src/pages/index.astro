---
import Layout from '../layouts/Layout.astro';
import BookCard from '../components/BookCard.astro';
import DownloadButtons from '../components/DownloadButtons.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';

const allBooks = await getCollection('books');
const collator = new Intl.Collator('ru', { sensitivity: 'base', numeric: true });
const sortedBooks = [...allBooks]
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime() || collator.compare(a.data.title, b.data.title))
  .map((book, index) => ({ book, addedIndex: index })); // Порядок по умолчанию: как книги добавлялись на сайт, новые сверху

const seriesCounts = new Map<string, number>();
allBooks.forEach(book => {
  const s = book.data.series;
  if (s) seriesCounts.set(s, (seriesCounts.get(s) || 0) + 1);
});

// У книги может быть несколько жанров: в поле genre они перечислены через запятую.
const splitGenres = (value?: string) =>
  (value || '')
    .split(',')
    .map((part) => part.trim())
    .filter((part) => part.length > 0);

const genreCounts = new Map<string, number>();
allBooks.forEach(book => {
  splitGenres(book.data.genre).forEach((genre) => {
    genreCounts.set(genre, (genreCounts.get(genre) || 0) + 1);
  });
});
const genreChips = [...genreCounts.entries()].sort((a, b) => b[1] - a[1] || collator.compare(a[0], b[0]));

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const heroEntry = [...allBooks].sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())[0];
const heroBook = heroEntry?.data;
const heroSummary = ((heroEntry?.body ?? '').trim().split(/\n\s*\n/)[0] ?? '')
  .replace(/[*_#>`\[\]]/g, '')
  .trim();
const heroExample = heroBook?.exampleImages?.[0];
const compareSources = sortedBooks
  .flatMap(({ book }) => {
    const image = book.data.exampleImages?.[1] ?? book.data.exampleImages?.[0];
    return image ? [{ title: book.data.title, image }] : [];
  })
  .slice(0, 3);

const compareCells = [
  ...compareSources.slice(0, 1).map((entry) => ({ type: 'image' as const, ...entry })),
  { type: 'note' as const },
  ...compareSources.slice(2, 3).map((entry) => ({ type: 'image' as const, ...entry })),
];
---

<Layout title="ChitAI | Библиотека иллюстрированных изданий">
  <section class="flex flex-col items-center text-center pb-6 mb-6 border-b border-white/5">
    <h1 class="max-w-none text-3xl md:text-5xl font-bold tracking-tight mb-6 bg-clip-text text-transparent bg-gradient-to-b from-white to-white/45 lg:whitespace-nowrap">
      Библиотека эксклюзивных иллюстрированных изданий
    </h1>
  </section>

  {heroEntry && heroBook && (
    <section id="hero-latest" class="mb-14" aria-label="Последнее издание">
      <a
        href={`${baseUrl}/books/${heroEntry.id}`}
        aria-label={`Открыть издание «${heroBook.title}»`}
        class="group grid items-center gap-8 rounded-[2.5rem] border border-white/10 bg-paper-alt/50 p-6 text-center transition-all duration-500 hover:border-accent/35 hover:bg-paper-alt/70 focus:outline-none focus-visible:border-accent/60 sm:p-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.1fr)_minmax(0,1fr)] lg:gap-12"
      >
        <div class="mx-auto w-full max-w-[440px]">
          <Image
            src={heroBook.coverImage}
            alt={`Обложка: ${heroBook.title}`}
            width={900}
            height={1350}
            sizes="(min-width: 1024px) 30vw, 92vw"
            class="h-auto w-full rounded-xl border border-white/10 shadow-2xl shadow-black/50 transition-transform duration-500 group-hover:-translate-y-1"
            loading="eager"
            fetchpriority="high"
            decoding="async"
            format="webp"
          />
        </div>
        <div class="flex flex-col items-center justify-center">
          <p class="type-ui text-xs font-black uppercase tracking-[0.22em] text-brass">Последнее издание</p>
          <h2 class="mt-4 text-4xl font-black leading-tight tracking-tight text-white transition-colors duration-500 group-hover:text-accent sm:text-5xl xl:text-6xl">{heroBook.title}</h2>
          <p class="type-ui mt-4 text-sm font-black uppercase tracking-[0.16em] text-accent sm:text-base">
            {heroBook.author}{heroBook.year ? ` · ${heroBook.year}` : ''}{heroBook.genre ? ` · ${heroBook.genre}` : ''}
          </p>
          {heroSummary && (
            <p class="mt-6 max-w-xl text-base leading-7 text-white text-justify hyphens-auto line-clamp-6 sm:text-lg sm:leading-8">{heroSummary}</p>
          )}
        </div>
        {heroExample && (
          <div class="mx-auto w-full max-w-[440px]">
            <Image
              src={heroExample}
              alt={`Иллюстрация из издания «${heroBook.title}»`}
              width={900}
              sizes="(min-width: 1024px) 30vw, 92vw"
              class="h-auto w-full rounded-xl border border-white/10 shadow-2xl shadow-black/50 transition-transform duration-500 group-hover:-translate-y-1"
              loading="eager"
              decoding="async"
              format="webp"
            />
          </div>
        )}
      </a>
    </section>
  )}

  {allBooks.length > 0 ? (
    <section id="catalog" aria-label="Полный каталог книг">
      <div id="catalog-filters" class="mb-6 flex w-full flex-wrap items-center gap-3">
        <div class="relative">
          <label for="filter-genre" class="sr-only">Жанр</label>
          <select id="filter-genre" class="type-ui h-12 w-full min-w-[11rem] cursor-pointer appearance-none rounded-2xl border border-white/10 bg-paper-alt pl-4 pr-10 text-sm font-bold text-ink transition-colors hover:border-accent/40 focus:border-accent/60 focus:outline-none">
            <option value="all">Все жанры ({allBooks.length})</option>
            {genreChips.map(([genre, count]) => (
              <option value={genre.toLowerCase()}>{genre} ({count})</option>
            ))}
          </select>
          <span class="pointer-events-none absolute right-4 top-1/2 -translate-y-1/2 text-xs text-accent" aria-hidden="true">▾</span>
        </div>
        <div class="relative">
          <label for="filter-sort" class="sr-only">Сортировка</label>
          <select id="filter-sort" class="type-ui h-12 w-full min-w-[13rem] cursor-pointer appearance-none rounded-2xl border border-white/10 bg-paper-alt pl-4 pr-10 text-sm font-bold text-ink transition-colors hover:border-accent/40 focus:border-accent/60 focus:outline-none">
            <option value="added">Сортировка: по добавлению</option>
            <option value="genre">Сортировка: по жанру</option>
            <option value="title">Сортировка: по названию</option>
            <option value="series">Сортировка: по серии</option>
          </select>
          <span class="pointer-events-none absolute right-4 top-1/2 -translate-y-1/2 text-xs text-accent" aria-hidden="true">▾</span>
        </div>
        <div id="catalog-search-panel" class="relative min-w-[14rem] flex-1">
          <label for="catalog-search" class="sr-only">Поиск по названию, автору или серии</label>
          <div class="absolute inset-y-0 left-4 flex items-center pointer-events-none">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-muted" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </div>
          <input
            type="search"
            id="catalog-search"
            class="type-ui h-12 w-full rounded-2xl border border-white/10 bg-paper-alt pl-11 pr-4 text-sm text-ink transition-colors placeholder:text-muted/70 hover:border-accent/40 focus:border-accent/60 focus:outline-none"
            placeholder="Поиск книг, авторов, серий..."
            aria-describedby="catalog-result-count"
          />
          <p id="catalog-result-count" class="sr-only" aria-live="polite"></p>
        </div>
        <noscript>
          <style is:inline>#filter-genre, #filter-sort, #catalog-search-panel { display: none; }</style>
          <p class="w-full text-sm text-muted">Поиск и фильтры доступны при включённом JavaScript, каталог ниже остаётся полностью видимым.</p>
        </noscript>
      </div>
      <div id="catalog-empty-state" class="hidden rounded-[2rem] border border-white/10 bg-paper-alt/98 sm:bg-white/[0.04] px-6 py-14 text-center shadow-2xl shadow-black/20 sm:backdrop-blur-md mb-6">
        <div class="mx-auto mb-5 grid h-16 w-16 place-items-center rounded-3xl border border-accent/25 bg-accent/10 text-2xl text-accent">⌕</div>
        <h2 class="mb-2 text-2xl font-black tracking-tight text-white">Ничего не найдено</h2>
        <p class="mx-auto mb-6 max-w-md text-muted">Попробуйте изменить запрос или сбросить поиск, чтобы снова увидеть весь каталог.</p>
        <button type="button" id="catalog-search-reset" class="inline-flex min-h-12 items-center rounded-full border border-accent/30 bg-accent/10 px-6 text-sm font-bold text-accent transition-all hover:bg-accent/20 focus:outline-none focus:ring-2 focus:ring-accent/40">
          Сбросить поиск
        </button>
      </div>

      <div id="catalog-rail-viewport" class="grid grid-cols-[4rem_minmax(0,1fr)_4rem] items-center gap-3 sm:gap-5">
        <div id="catalog-rail" class="catalog-rail col-start-2 row-start-1 min-w-0">
        {sortedBooks.map(({ book, addedIndex }) => (
          <div class="book-card-wrapper h-full" data-title={book.data.title.toLowerCase()} data-author={book.data.author.toLowerCase()} data-series={book.data.series?.toLowerCase() || ''} data-series-order={book.data.seriesOrder ?? ''} data-genre={splitGenres(book.data.genre).map((genre) => genre.toLowerCase()).join(',')} data-added={addedIndex}>
            <BookCard
              title={book.data.title}
              author={book.data.author}
              coverImage={book.data.coverImage}
              slug={book.id}
              series={book.data.series}
              seriesOrder={book.data.seriesOrder}
              seriesCount={book.data.series ? seriesCounts.get(book.data.series) : undefined}
              imageLoading="lazy"
              imageFetchPriority="auto"
            />
          </div>
        ))}
        </div>
        <div id="catalog-rail-controls" class="contents">
          <button type="button" data-rail-prev aria-label="Предыдущие книги" class="rail-pulse col-start-1 row-start-1 grid h-16 w-16 cursor-pointer place-items-center self-center rounded-full border-2 border-white bg-accent text-4xl font-black leading-none text-black transition-colors hover:bg-white focus:outline-none focus:ring-4 focus:ring-accent/50 disabled:cursor-default disabled:border-white/20 disabled:bg-white/10 disabled:text-white/30">‹</button>
          <button type="button" data-rail-next aria-label="Следующие книги" class="rail-pulse col-start-3 row-start-1 grid h-16 w-16 cursor-pointer place-items-center self-center rounded-full border-2 border-white bg-accent text-4xl font-black leading-none text-black transition-colors hover:bg-white focus:outline-none focus:ring-4 focus:ring-accent/50 disabled:cursor-default disabled:border-white/20 disabled:bg-white/10 disabled:text-white/30">›</button>
          <p id="catalog-rail-status" class="type-ui col-span-3 row-start-2 justify-self-center rounded-full border border-white/15 bg-black/85 px-4 py-1 text-xs font-black tracking-[0.12em] text-white" aria-live="polite"></p>
        </div>
      </div>
    </section>
  ) : (
    <section id="catalog" class="py-20 border-t border-ink/15">
      <p class="text-lg text-muted text-center">Каталог пуст. Добавьте файлы в src/content/books/</p>
    </section>
  )}

  {compareSources.length > 0 && (
    <section id="color-vs-bw" class="mt-16 border-t border-white/5 pt-10" aria-label="Сравнение цветной и чёрно-белой версии">
      <h2 class="mb-6 text-2xl font-black tracking-tight text-white sm:text-3xl">Цветная и чёрно-белая версия</h2>
      <div class="grid grid-cols-2 items-stretch gap-4 sm:gap-6 lg:grid-cols-[minmax(0,1fr)_minmax(0,2.2fr)_minmax(0,1fr)]">
        {compareCells.map((cell) => cell.type === 'note' ? (
          <div class="order-3 col-span-2 flex flex-col justify-center rounded-xl border border-accent/25 bg-accent/[0.06] p-6 sm:p-8 lg:order-none lg:col-span-1 lg:p-10">
            <h3 class="type-ui text-lg font-black uppercase tracking-[0.14em] text-brass sm:text-xl">Зачем две версии</h3>
            <p class="mt-6 text-base leading-relaxed text-white text-justify hyphens-auto sm:text-lg">Это не «полная» и «урезанная» книга, а две равноценные подачи одних и тех же иллюстраций. Выбор зависит от вашего устройства и от того, какое настроение вы хотите от чтения.</p>
            <p class="mt-5 text-base leading-relaxed text-white text-justify hyphens-auto sm:text-lg"><b class="text-accent">Цветная версия</b> — иллюстрации такими, какими они были нарисованы: все оттенки, полутона и цветовые акценты. Она раскрывается на любом светящемся экране — телефон, планшет, компьютер или цветная читалка.</p>
            <p class="mt-5 text-base leading-relaxed text-white text-justify hyphens-auto sm:text-lg"><b class="text-accent">Чёрно-белая версия</b> — самостоятельный вариант оформления, а не замена цветной. Контраст усилен, в рисунке на первый план выходят штрих, свет и тень — получается настроение старого книжного издания с гравюрами. Её часто берут и на обычном экране — ради атмосферы.</p>
            <p class="mt-5 text-base leading-relaxed text-white text-justify hyphens-auto sm:text-lg">Если вы читаете на читалке с электронными чернилами, выбор очевиден: цветные краски такой экран показать не сможет и сведёт их в мутное серое пятно, а чёрно-белая версия сделана именно под такой экран и остаётся чёткой.</p>
            <p class="mt-5 text-base leading-relaxed text-white text-justify hyphens-auto sm:text-lg">Текст, вёрстка, оглавление и набор иллюстраций в обеих версиях одинаковы — отличается только подача графики.</p>
            <p class="mt-6 text-sm text-muted text-justify hyphens-auto sm:text-base">Обе версии бесплатны и лежат рядом в каждой книге — берите любую или сразу две. Чтобы увидеть разницу, потяните ползунок на картинках по бокам.</p>
          </div>
        ) : (
          <div
            class="cmp-frame relative h-[440px] w-full cursor-ew-resize touch-none select-none overflow-hidden rounded-xl border border-white/10 bg-paper sm:h-[560px] lg:h-[660px]"
            style="--split: 50%;"
            role="slider"
            tabindex="0"
            aria-label={`Сравнение версий: ${cell.title}`}
            aria-valuemin="0"
            aria-valuemax="100"
            aria-valuenow="50"
          >
            <Image
              src={cell.image}
              alt={`Иллюстрация из издания «${cell.title}» в цвете`}
              width={700}
              sizes="(min-width: 1024px) 22vw, 45vw"
              class="absolute inset-0 block h-full w-full object-cover"
              format="webp"
              loading="lazy"
              decoding="async"
              draggable="false"
            />
            <div class="pointer-events-none absolute inset-0" style="clip-path: inset(0 0 0 var(--split));">
              <Image
                src={cell.image}
                alt=""
                width={700}
                sizes="(min-width: 1024px) 22vw, 45vw"
                class="cmp-bw absolute inset-0 block h-full w-full object-cover"
                format="webp"
                loading="lazy"
                decoding="async"
                draggable="false"
              />
            </div>
            <div class="pointer-events-none absolute inset-y-0 w-0.5 -translate-x-1/2 bg-accent/80" style="left: var(--split);" aria-hidden="true">
              <span class="absolute left-1/2 top-1/2 grid h-8 w-8 -translate-x-1/2 -translate-y-1/2 place-items-center rounded-full border border-accent/60 bg-black/70 text-xs text-accent backdrop-blur-sm">⇄</span>
            </div>
          </div>
        ))}
      </div>
    </section>
  )}

  <script>
    type ChitaiCatalogSearchState = {
      isBound: boolean;
    };

    const globalWindow = window as Window & typeof globalThis & {
      __chitaiCatalogSearch?: ChitaiCatalogSearchState;
    };

    const state = globalWindow.__chitaiCatalogSearch ?? { isBound: false };
    globalWindow.__chitaiCatalogSearch = state;

    const PANEL_CLASS = 'series-panel';
    const prefersReducedMotion = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const closeSeriesPanel = (animate = true): Promise<void> => {
      const existing = document.querySelector(`.${PANEL_CLASS}`) as HTMLElement | null;
      if (!existing) return Promise.resolve();

      if (!animate || prefersReducedMotion()) {
        existing.remove();
        document.body.style.overflow = '';
        return Promise.resolve();
      }

      const inner = existing.querySelector('.series-panel-inner') as HTMLElement | null;
      if (inner) {
        inner.style.transition = 'opacity 0.2s ease, transform 0.2s ease';
        inner.style.opacity = '0';
        inner.style.transform = 'scale(0.95)';
      }

      return new Promise((resolve) => {
        let done = false;
        const finish = () => {
          if (done) return;
          done = true;
          existing.remove();
          document.body.style.overflow = '';
          resolve();
        };
        if (inner) inner.addEventListener('transitionend', finish, { once: true });
        setTimeout(finish, 250);
      });
    };

    const openSeriesPanel = (seriesName: string, triggerWrapper: HTMLElement) => {
      const grid = triggerWrapper.parentElement;
      if (!grid) return;

      const seriesLower = seriesName.toLowerCase();
      const allWrappers = Array.from(grid.querySelectorAll(`.book-card-wrapper[data-series="${CSS.escape(seriesLower)}"]`)) as HTMLElement[];
      if (allWrappers.length === 0) return;

      const triggerHref = triggerWrapper.querySelector('a')?.getAttribute('href') || '';

      const panel = document.createElement('div');
      panel.className = PANEL_CLASS;
      panel.dataset.seriesName = seriesName;
      panel.dataset.triggerId = triggerWrapper.getAttribute('data-title') || '';
      panel.style.cssText = 'position:fixed;inset:0;z-index:9997;display:flex;align-items:center;justify-content:center;background:rgba(0,0,0,0.70);backdrop-filter:blur(4px);-webkit-backdrop-filter:blur(4px);';

      panel.addEventListener('click', (e) => {
        if (e.target === panel) closeSeriesPanel();
      });

      document.body.style.overflow = 'hidden';

      const inner = document.createElement('div');
      inner.className = 'series-panel-inner';
      const isMobile = window.innerWidth < 768;
      inner.style.cssText = `position:relative;width:100%;max-width:76rem;margin:0 1rem;border-radius:1.75rem;border:1px solid rgba(255,255,255,0.1);background:rgba(5,5,5,${isMobile ? '0.98' : '0.88'});padding:2rem;box-shadow:0 28px 90px rgba(0,0,0,0.6);${isMobile ? '' : 'backdrop-filter:blur(24px);-webkit-backdrop-filter:blur(24px);'}`;

      if (!prefersReducedMotion()) {
        inner.style.opacity = '0';
        inner.style.transform = 'scale(0.95)';
      }

      const header = document.createElement('div');
      header.style.cssText = 'display:flex;align-items:center;justify-content:space-between;margin-bottom:1rem;';

      const titleEl = document.createElement('h3');
      titleEl.className = 'type-ui text-lg font-black uppercase tracking-[0.16em] text-accent';
      titleEl.textContent = seriesName;
      header.appendChild(titleEl);

      const closeBtn = document.createElement('button');
      closeBtn.type = 'button';
      closeBtn.className = 'grid place-items-center h-8 w-8 rounded-full border border-white/10 bg-white/[0.04] text-muted hover:text-white hover:bg-white/10 transition-colors cursor-pointer';
      closeBtn.setAttribute('aria-label', 'Закрыть панель серии');
      closeBtn.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"/></svg>`;
      closeBtn.addEventListener('click', () => closeSeriesPanel());
      header.appendChild(closeBtn);

      inner.appendChild(header);

      const content = document.createElement('div');
      content.className = 'type-ui';
      content.style.cssText = 'display:flex;gap:1.25rem;overflow-x:auto;padding-bottom:0.5rem;max-width:max-content;margin:0 auto;';

      allWrappers.forEach((wrapper) => {
        const img = wrapper.querySelector('img');
        const link = wrapper.querySelector('a');
        const title = wrapper.querySelector('h3')?.textContent || wrapper.getAttribute('data-title') || '';
        const href = link?.getAttribute('href') || '#';
        const imgSrc = img?.getAttribute('src') || '';

        const isTriggerBook = href === triggerHref;

        const card = document.createElement('a');
        card.href = href;
        card.className = 'group/mini flex flex-col items-center shrink-0 rounded-xl p-4 transition-colors hover:bg-white/[0.06]';
        card.style.cssText = 'width:260px;text-decoration:none;';

        const thumb = document.createElement('div');
        thumb.style.cssText = 'width:220px;aspect-ratio:2/3;border-radius:0.75rem;overflow:hidden;margin-bottom:1rem;';
        thumb.className = isTriggerBook
          ? 'border-2 border-accent shadow-xl shadow-accent/20'
          : 'border border-white/10 shadow-lg';

        if (imgSrc) {
          const thumbImg = document.createElement('img');
          thumbImg.src = imgSrc;
          thumbImg.alt = '';
          thumbImg.loading = 'lazy';
          thumbImg.decoding = 'async';
          thumbImg.style.cssText = 'width:100%;height:100%;object-fit:cover;';
          thumb.appendChild(thumbImg);
        }

        card.appendChild(thumb);

        const label = document.createElement('span');
        label.className = 'text-lg font-medium text-center leading-snug text-white/90 group-hover/mini:text-white transition-colors line-clamp-2';
        label.style.cssText = 'display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;';
        label.textContent = title;
        card.appendChild(label);

        content.appendChild(card);
      });

      inner.appendChild(content);
      panel.appendChild(inner);

      document.body.appendChild(panel);

      if (!prefersReducedMotion()) {
        requestAnimationFrame(() => {
          requestAnimationFrame(() => {
            inner.style.transition = 'opacity 0.3s ease, transform 0.3s ease';
            inner.style.opacity = '1';
            inner.style.transform = 'scale(1)';
          });
        });
      }
    };

    const initializeCatalogSearch = () => {
      const searchInput = document.getElementById('catalog-search') as HTMLInputElement | null;
      const resultCountStatus = document.getElementById('catalog-result-count');
      const resetButton = document.getElementById('catalog-search-reset') as HTMLButtonElement | null;

      if (!searchInput || searchInput.dataset.searchBound === 'true') return;

      searchInput.dataset.searchBound = 'true';
      if (resetButton) resetButton.dataset.searchBound = 'true';

      const genreSelect = document.getElementById('filter-genre') as HTMLSelectElement | null;
      const sortSelect = document.getElementById('filter-sort') as HTMLSelectElement | null;
      const jsCollator = new Intl.Collator('ru', { sensitivity: 'base', numeric: true });

      let activeGenre = 'all';
      let activeSort = 'added';

      const compareCards = (a: HTMLElement, b: HTMLElement) => {
        const titleA = a.dataset.title || '';
        const titleB = b.dataset.title || '';

        if (activeSort === 'genre') {
          const genreA = (a.dataset.genre || '').split(',')[0] || 'яяя';
          const genreB = (b.dataset.genre || '').split(',')[0] || 'яяя';
          const byGenre = jsCollator.compare(genreA, genreB);
          return byGenre !== 0 ? byGenre : jsCollator.compare(titleA, titleB);
        }

        if (activeSort === 'title') return jsCollator.compare(titleA, titleB);

        if (activeSort === 'series') {
          const seriesA = a.dataset.series || '';
          const seriesB = b.dataset.series || '';
          if (Boolean(seriesA) !== Boolean(seriesB)) return seriesA ? -1 : 1;

          const bySeries = jsCollator.compare(seriesA, seriesB);
          if (bySeries !== 0) return bySeries;

          const orderA = a.dataset.seriesOrder ? Number(a.dataset.seriesOrder) : Number.POSITIVE_INFINITY;
          const orderB = b.dataset.seriesOrder ? Number(b.dataset.seriesOrder) : Number.POSITIVE_INFINITY;
          if (orderA !== orderB) return orderA - orderB;

          return jsCollator.compare(titleA, titleB);
        }

        return Number(a.dataset.added ?? 0) - Number(b.dataset.added ?? 0);
      };

      const railElement = document.getElementById('catalog-rail');
      let lastColumnCount = 0;

      const measureColumns = (visibleCards: HTMLElement[]) => {
        if (!railElement) return 1;
        const columnGap = parseFloat(getComputedStyle(railElement).columnGap) || 0;
        const cardWidth = visibleCards[0]?.getBoundingClientRect().width ?? 0;
        if (cardWidth <= 0) return 1;
        return Math.max(1, Math.round((railElement.clientWidth + columnGap) / (cardWidth + columnGap)));
      };

      // Лента заполняется по столбцам (grid-auto-flow: column), поэтому порядок
      // сортировки раскладывается по строкам вручную: чтение идёт слева направо.
      const applySort = (cards: HTMLElement[]) => {
        const visibleCards = cards.filter((card) => !card.hidden);
        const orderedCards = activeSort === 'added' ? visibleCards : [...visibleCards].sort(compareCards);

        const columns = measureColumns(visibleCards);
        lastColumnCount = columns;
        const rows = visibleCards.length <= columns ? 1 : 2;
        const perPage = columns * rows;

        cards.forEach((card) => {
          card.style.order = '';
        });

        orderedCards.forEach((card, rank) => {
          const page = Math.floor(rank / perPage);
          const cell = rank % perPage;
          const row = Math.floor(cell / columns);
          const column = cell % columns;
          card.style.order = String(page * perPage + column * rows + row);
        });
      };

      const updateCatalog = () => {
        const catalogCards = Array.from(document.querySelectorAll('#catalog .book-card-wrapper')) as HTMLElement[];
        const emptyState = document.getElementById('catalog-empty-state');
        const query = searchInput.value.toLowerCase().trim();
        const isFiltering = Boolean(query) || activeGenre !== 'all';
        let visibleCount = 0;

        closeSeriesPanel(false);

        catalogCards.forEach((card) => {
          const title = card.getAttribute('data-title') || '';
          const author = card.getAttribute('data-author') || '';
          const series = card.getAttribute('data-series') || '';
          const genre = card.getAttribute('data-genre') || '';

          const matchesQuery = !query || title.includes(query) || author.includes(query) || series.includes(query);
          const matchesGenre = activeGenre === 'all' || (genre ? genre.split(',').indexOf(activeGenre) !== -1 : false);
          const isVisible = matchesQuery && matchesGenre;

          card.hidden = !isVisible;
          if (isVisible) visibleCount += 1;
        });

        applySort(catalogCards);

        if (railElement) {
          railElement.scrollTo({ left: 0, behavior: 'auto' });
          railElement.dispatchEvent(new CustomEvent('chitai:catalog-updated'));
        }

        emptyState?.classList.toggle('hidden', !isFiltering || visibleCount > 0);
        if (resultCountStatus) resultCountStatus.textContent = isFiltering
          ? `Найдено книг: ${visibleCount} из ${catalogCards.length}`
          : `Доступно книг: ${visibleCount} из ${catalogCards.length}`;
      };

      searchInput.addEventListener('input', updateCatalog);
      genreSelect?.addEventListener('change', () => {
        activeGenre = genreSelect.value;
        updateCatalog();
      });
      sortSelect?.addEventListener('change', () => {
        activeSort = sortSelect.value;
        updateCatalog();
      });
      resetButton?.addEventListener('click', () => {
        searchInput.value = '';
        activeGenre = 'all';
        activeSort = 'added';
        if (genreSelect) genreSelect.value = 'all';
        if (sortSelect) sortSelect.value = 'added';
        updateCatalog();
        searchInput.focus();
      });
      updateCatalog();

      // При смене числа столбцов (другой размер окна) раскладку надо пересчитать.
      if (railElement) {
        let relayoutId = 0;

        const relayout = () => {
          relayoutId = 0;
          const catalogCards = Array.from(document.querySelectorAll('#catalog .book-card-wrapper')) as HTMLElement[];
          const visibleCards = catalogCards.filter((card) => !card.hidden);
          if (measureColumns(visibleCards) === lastColumnCount) return;

          applySort(catalogCards);
          railElement.dispatchEvent(new CustomEvent('chitai:catalog-updated'));
        };

        new ResizeObserver(() => {
          if (!relayoutId) relayoutId = requestAnimationFrame(relayout);
        }).observe(railElement);
      }

      const bindSeriesClick = (containerId: string) => {
        const container = document.getElementById(containerId);
        container?.addEventListener('click', (event) => {
          const target = event.target as HTMLElement;
          const trigger = target.closest('[data-series-trigger]') as HTMLElement | null;
          if (!trigger) return;

          event.preventDefault();
          event.stopPropagation();

          const seriesName = trigger.getAttribute('data-series-trigger');
          const wrapper = trigger.closest('.book-card-wrapper') as HTMLElement | null;
          if (!seriesName || !wrapper) return;

          const existingPanel = document.querySelector(`.${PANEL_CLASS}`) as HTMLElement | null;
          const isAlreadyOpen = existingPanel?.dataset.seriesName === seriesName &&
            existingPanel?.dataset.triggerId === wrapper.getAttribute('data-title');

          if (isAlreadyOpen) {
            closeSeriesPanel();
            return;
          }

          closeSeriesPanel(false).then(() => openSeriesPanel(seriesName, wrapper));
        });
      };

      bindSeriesClick('catalog');
    };

    const initializeComparators = () => {
      const frames = Array.from(document.querySelectorAll('.cmp-frame')) as HTMLElement[];

      frames.forEach((frame) => {
        if (frame.dataset.cmpBound === 'true') return;

        frame.dataset.cmpBound = 'true';

        let split = 50;
        let frameId = 0;
        let isDragging = false;

        const paintSplit = () => {
          frameId = 0;
          frame.style.setProperty('--split', `${split}%`);
          frame.setAttribute('aria-valuenow', String(Math.round(split)));
        };

        const setSplit = (value: number) => {
          split = Math.min(100, Math.max(0, value));
          if (!frameId) frameId = requestAnimationFrame(paintSplit);
        };

        const splitFromPointer = (event: PointerEvent) => {
          const rect = frame.getBoundingClientRect();
          if (!rect.width) return;
          setSplit(((event.clientX - rect.left) / rect.width) * 100);
        };

        const stopDragging = (event: PointerEvent) => {
          if (!isDragging) return;
          isDragging = false;
          if (frame.hasPointerCapture(event.pointerId)) frame.releasePointerCapture(event.pointerId);
        };

        frame.addEventListener('pointerdown', (event: PointerEvent) => {
          event.preventDefault();
          isDragging = true;
          frame.setPointerCapture(event.pointerId);
          splitFromPointer(event);
        });
        frame.addEventListener('pointermove', (event: PointerEvent) => {
          if (!isDragging) return;
          splitFromPointer(event);
        });
        frame.addEventListener('pointerup', stopDragging);
        frame.addEventListener('pointercancel', stopDragging);
        frame.addEventListener('dragstart', (event: Event) => event.preventDefault());
        frame.addEventListener('keydown', (event: KeyboardEvent) => {
          const step = event.shiftKey ? 10 : 2;
          if (event.key === 'ArrowLeft') {
            event.preventDefault();
            setSplit(split - step);
          }
          if (event.key === 'ArrowRight') {
            event.preventDefault();
            setSplit(split + step);
          }
        });
      });
    };

    const initializeCatalogRail = () => {
      const rail = document.getElementById('catalog-rail');
      if (!rail || rail.dataset.railBound === 'true') return;

      rail.dataset.railBound = 'true';

      const controls = document.getElementById('catalog-rail-controls');
      const status = document.getElementById('catalog-rail-status');
      const prevButton = document.querySelector('[data-rail-prev]') as HTMLButtonElement | null;
      const nextButton = document.querySelector('[data-rail-next]') as HTMLButtonElement | null;
      let syncId = 0;

      const columnStep = () => {
        const offsets = (Array.from(rail.children) as HTMLElement[])
          .filter((child) => !child.hidden)
          .map((child) => child.offsetLeft);
        const unique = [...new Set(offsets)].sort((a, b) => a - b);
        if (unique.length < 2) return rail.clientWidth;
        return unique[1] - unique[0];
      };

      const pageWidth = () => {
        const step = columnStep();
        if (step <= 0) return Math.max(1, rail.clientWidth);
        const columns = Math.max(1, Math.round(rail.clientWidth / step));
        return Math.max(1, step * columns);
      };

      const sync = () => {
        syncId = 0;
        const visibleChildren = (Array.from(rail.children) as HTMLElement[]).filter((child) => !child.hidden);
        const railStyle = getComputedStyle(rail);
        const columnGap = parseFloat(railStyle.columnGap) || 0;
        const cardWidth = visibleChildren[0]?.getBoundingClientRect().width ?? 0;
        const columnsPerView = cardWidth > 0 ? Math.max(1, Math.round((rail.clientWidth + columnGap) / (cardWidth + columnGap))) : 1;

        rail.classList.toggle('catalog-rail--single-row', visibleChildren.length <= columnsPerView);

        const maxScroll = rail.scrollWidth - rail.clientWidth;
        const page = pageWidth();
        const totalPages = Math.max(1, Math.ceil(rail.scrollWidth / page));
        const currentPage = Math.min(totalPages, Math.floor(rail.scrollLeft / page) + 1);

        if (prevButton) prevButton.disabled = false;
        if (nextButton) nextButton.disabled = false;
        if (controls) controls.classList.toggle('is-hidden', maxScroll <= 1);
        if (status) status.textContent = `${currentPage} / ${totalPages}`;
      };

      const requestSync = () => {
        if (!syncId) syncId = requestAnimationFrame(sync);
      };

      const scrollByPage = (direction: number) => {
        const maxScroll = rail.scrollWidth - rail.clientWidth;
        if (maxScroll <= 1) return;

        const behavior = prefersReducedMotion() ? 'auto' : 'smooth';
        let target = rail.scrollLeft + pageWidth() * direction;

        if (direction > 0 && rail.scrollLeft >= maxScroll - 1) {
          target = 0;
        } else if (direction < 0 && rail.scrollLeft <= 1) {
          target = maxScroll;
        } else {
          target = Math.min(Math.max(target, 0), maxScroll);
        }

        rail.scrollTo({ left: target, behavior });
      };

      prevButton?.addEventListener('click', () => scrollByPage(-1));
      nextButton?.addEventListener('click', () => scrollByPage(1));
      rail.addEventListener('scroll', requestSync, { passive: true });
      rail.addEventListener('chitai:catalog-updated', requestSync);
      window.addEventListener('resize', requestSync);
      requestSync();
    };

    if (!state.isBound) {
      state.isBound = true;
      // astro:after-swap срабатывает сразу после подмены DOM, до анимации перехода,
      // поэтому лента сразу получает верную раскладку без промежуточного кадра.
      document.addEventListener('astro:after-swap', initializeCatalogSearch);
      document.addEventListener('astro:after-swap', initializeCatalogRail);
      document.addEventListener('astro:page-load', initializeCatalogSearch);
      document.addEventListener('astro:page-load', initializeComparators);
      document.addEventListener('astro:page-load', initializeCatalogRail);
    }

    initializeCatalogSearch();
    initializeComparators();
    initializeCatalogRail();
  </script>
</Layout>
