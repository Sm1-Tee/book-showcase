---
import Layout from '../layouts/Layout.astro';
import BookCard from '../components/BookCard.astro';
import { getCollection } from 'astro:content';

const allBooks = await getCollection('books');
const collator = new Intl.Collator('ru', { sensitivity: 'base', numeric: true });
const sortedBooks = [...allBooks]
  .sort((a, b) => {
    const aSeries = a.data.series || '';
    const bSeries = b.data.series || '';

    if (aSeries && !bSeries) return -1;
    if (!aSeries && bSeries) return 1;

    if (aSeries && bSeries) {
      const seriesCompare = collator.compare(aSeries, bSeries);
      if (seriesCompare !== 0) return seriesCompare;

      const aOrder = a.data.seriesOrder ?? Number.POSITIVE_INFINITY;
      const bOrder = b.data.seriesOrder ?? Number.POSITIVE_INFINITY;
      if (aOrder !== bOrder) return aOrder - bOrder;
    }

    return collator.compare(a.data.title, b.data.title);
  })
  .map((book, index) => ({ book, isPriorityImage: index < 12 })); // Предзагружаем первые 12 обложек (те, что видны на первом экране)

const latestBooks = [...allBooks]
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 6)
  .map((book, index) => ({ book, isPriorityImage: true })); // Все новинки видны сразу

const seriesCounts = new Map<string, number>();
allBooks.forEach(book => {
  const s = book.data.series;
  if (s) seriesCounts.set(s, (seriesCounts.get(s) || 0) + 1);
});
---

<Layout title="ChitAI | Библиотека иллюстрированных изданий">
  <section class="flex flex-col items-center text-center pb-6 mb-6 border-b border-white/5">
    <h1 class="max-w-5xl text-3xl md:text-5xl font-bold tracking-tight mb-6 bg-clip-text text-transparent bg-gradient-to-b from-white to-white/45">
      Библиотека эксклюзивных иллюстрированных изданий
    </h1>

    <div id="catalog-search-panel" class="hidden w-full max-w-xl relative">
      <label for="catalog-search" class="sr-only">Поиск по названию, автору или серии</label>
      <div class="absolute inset-y-0 left-4 flex items-center pointer-events-none">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-muted" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </div>
      <input
        type="search"
        id="catalog-search"
        class="w-full bg-paper-alt/98 sm:bg-paper-alt/50 sm:backdrop-blur-md border border-white/10 text-ink text-sm sm:text-base pl-11 pr-4 py-3 rounded-2xl focus:outline-none focus:border-accent/50 focus:ring-1 focus:ring-accent/50 transition-all type-ui placeholder:text-muted/70 shadow-2xl"
        placeholder="Поиск книг, авторов, серий..."
        aria-describedby="catalog-result-count"
      />
      <p id="catalog-result-count" class="sr-only" aria-live="polite"></p>
    </div>
    <noscript>
      <p class="mt-3 text-sm text-muted">Поиск доступен при включённом JavaScript, каталог ниже остаётся полностью видимым.</p>
    </noscript>
  </section>

  {latestBooks.length > 0 && (
    <section class="mb-12" aria-label="Новинки">
      <div class="flex items-center justify-between mb-6 px-2">
        <h2 class="text-2xl font-bold tracking-tight text-white">Последние поступления</h2>
      </div>
      <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 sm:gap-6 lg:grid-cols-4 xl:grid-cols-6">
        {latestBooks.map(({ book, isPriorityImage }) => (
          <div class="book-card-wrapper h-full" data-title={book.data.title.toLowerCase()} data-author={book.data.author.toLowerCase()} data-series={book.data.series?.toLowerCase() || ''}>
            <BookCard
              title={book.data.title}
              author={book.data.author}
              coverImage={book.data.coverImage}
              slug={book.id}
              series={book.data.series}
              seriesOrder={book.data.seriesOrder}
              seriesCount={book.data.series ? seriesCounts.get(book.data.series) : undefined}
              imageLoading={isPriorityImage ? 'eager' : 'lazy'}
              imageFetchPriority={isPriorityImage ? 'high' : 'auto'}
            />
          </div>
        ))}
      </div>
    </section>
  )}

  {allBooks.length > 0 ? (
    <section id="catalog" aria-label="Полный каталог книг">
      <div class="flex items-center justify-between mb-6 px-2">
        <h2 class="text-2xl font-bold tracking-tight text-white">Все книги</h2>
      </div>
      <div id="catalog-empty-state" class="hidden rounded-[2rem] border border-white/10 bg-paper-alt/98 sm:bg-white/[0.04] px-6 py-14 text-center shadow-2xl shadow-black/20 sm:backdrop-blur-md mb-6">
        <div class="mx-auto mb-5 grid h-16 w-16 place-items-center rounded-3xl border border-accent/25 bg-accent/10 text-2xl text-accent">⌕</div>
        <h2 class="mb-2 text-2xl font-black tracking-tight text-white">Ничего не найдено</h2>
        <p class="mx-auto mb-6 max-w-md text-muted">Попробуйте изменить запрос или сбросить поиск, чтобы снова увидеть весь каталог.</p>
        <button type="button" id="catalog-search-reset" class="inline-flex min-h-12 items-center rounded-full border border-accent/30 bg-accent/10 px-6 text-sm font-bold text-accent transition-all hover:bg-accent/20 focus:outline-none focus:ring-2 focus:ring-accent/40">
          Сбросить поиск
        </button>
      </div>

      <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 sm:gap-6 lg:grid-cols-4 xl:grid-cols-6">
        {sortedBooks.map(({ book, isPriorityImage }) => (
          <div class="book-card-wrapper h-full" data-title={book.data.title.toLowerCase()} data-author={book.data.author.toLowerCase()} data-series={book.data.series?.toLowerCase() || ''}>
            <BookCard
              title={book.data.title}
              author={book.data.author}
              coverImage={book.data.coverImage}
              slug={book.id}
              series={book.data.series}
              seriesOrder={book.data.seriesOrder}
              seriesCount={book.data.series ? seriesCounts.get(book.data.series) : undefined}
              imageLoading={isPriorityImage ? 'eager' : 'lazy'}
              imageFetchPriority={isPriorityImage ? 'high' : 'auto'}
            />
          </div>
        ))}
      </div>
    </section>
  ) : (
    <section id="catalog" class="py-20 border-t border-ink/15">
      <p class="text-lg text-muted text-center">Каталог пуст. Добавьте файлы в src/content/books/</p>
    </section>
  )}

  <script>
    type ChitaiCatalogSearchState = {
      isBound: boolean;
    };

    const globalWindow = window as Window & typeof globalThis & {
      __chitaiCatalogSearch?: ChitaiCatalogSearchState;
    };

    const state = globalWindow.__chitaiCatalogSearch ?? { isBound: false };
    globalWindow.__chitaiCatalogSearch = state;

    const PANEL_CLASS = 'series-panel';
    const prefersReducedMotion = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const closeSeriesPanel = (animate = true): Promise<void> => {
      const existing = document.querySelector(`.${PANEL_CLASS}`) as HTMLElement | null;
      if (!existing) return Promise.resolve();

      if (!animate || prefersReducedMotion()) {
        existing.remove();
        document.body.style.overflow = '';
        return Promise.resolve();
      }

      const inner = existing.querySelector('.series-panel-inner') as HTMLElement | null;
      if (inner) {
        inner.style.transition = 'opacity 0.2s ease, transform 0.2s ease';
        inner.style.opacity = '0';
        inner.style.transform = 'scale(0.95)';
      }

      return new Promise((resolve) => {
        let done = false;
        const finish = () => {
          if (done) return;
          done = true;
          existing.remove();
          document.body.style.overflow = '';
          resolve();
        };
        if (inner) inner.addEventListener('transitionend', finish, { once: true });
        setTimeout(finish, 250);
      });
    };

    const openSeriesPanel = (seriesName: string, triggerWrapper: HTMLElement) => {
      const grid = triggerWrapper.parentElement;
      if (!grid) return;

      const seriesLower = seriesName.toLowerCase();
      const allWrappers = Array.from(grid.querySelectorAll(`.book-card-wrapper[data-series="${CSS.escape(seriesLower)}"]`)) as HTMLElement[];
      if (allWrappers.length === 0) return;

      const triggerHref = triggerWrapper.querySelector('a')?.getAttribute('href') || '';

      const panel = document.createElement('div');
      panel.className = PANEL_CLASS;
      panel.dataset.seriesName = seriesName;
      panel.dataset.triggerId = triggerWrapper.getAttribute('data-title') || '';
      panel.style.cssText = 'position:fixed;inset:0;z-index:9997;display:flex;align-items:center;justify-content:center;background:rgba(0,0,0,0.70);backdrop-filter:blur(4px);-webkit-backdrop-filter:blur(4px);';

      panel.addEventListener('click', (e) => {
        if (e.target === panel) closeSeriesPanel();
      });

      document.body.style.overflow = 'hidden';

      const inner = document.createElement('div');
      inner.className = 'series-panel-inner';
      const isMobile = window.innerWidth < 768;
      inner.style.cssText = `position:relative;width:100%;max-width:76rem;margin:0 1rem;border-radius:1.75rem;border:1px solid rgba(255,255,255,0.1);background:rgba(5,5,5,${isMobile ? '0.98' : '0.88'});padding:2rem;box-shadow:0 28px 90px rgba(0,0,0,0.6);${isMobile ? '' : 'backdrop-filter:blur(24px);-webkit-backdrop-filter:blur(24px);'}`;

      if (!prefersReducedMotion()) {
        inner.style.opacity = '0';
        inner.style.transform = 'scale(0.95)';
      }

      const header = document.createElement('div');
      header.style.cssText = 'display:flex;align-items:center;justify-content:space-between;margin-bottom:1rem;';

      const titleEl = document.createElement('h3');
      titleEl.className = 'type-ui text-lg font-black uppercase tracking-[0.16em] text-accent';
      titleEl.textContent = seriesName;
      header.appendChild(titleEl);

      const closeBtn = document.createElement('button');
      closeBtn.type = 'button';
      closeBtn.className = 'grid place-items-center h-8 w-8 rounded-full border border-white/10 bg-white/[0.04] text-muted hover:text-white hover:bg-white/10 transition-colors cursor-pointer';
      closeBtn.setAttribute('aria-label', 'Закрыть панель серии');
      closeBtn.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"/></svg>`;
      closeBtn.addEventListener('click', () => closeSeriesPanel());
      header.appendChild(closeBtn);

      inner.appendChild(header);

      const content = document.createElement('div');
      content.className = 'type-ui';
      content.style.cssText = 'display:flex;gap:1.25rem;overflow-x:auto;padding-bottom:0.5rem;max-width:max-content;margin:0 auto;';

      allWrappers.forEach((wrapper) => {
        const img = wrapper.querySelector('img');
        const link = wrapper.querySelector('a');
        const title = wrapper.querySelector('h3')?.textContent || wrapper.getAttribute('data-title') || '';
        const href = link?.getAttribute('href') || '#';
        const imgSrc = img?.getAttribute('src') || '';

        const isTriggerBook = href === triggerHref;

        const card = document.createElement('a');
        card.href = href;
        card.className = 'group/mini flex flex-col items-center shrink-0 rounded-xl p-4 transition-colors hover:bg-white/[0.06]';
        card.style.cssText = 'width:260px;text-decoration:none;';

        const thumb = document.createElement('div');
        thumb.style.cssText = 'width:220px;aspect-ratio:2/3;border-radius:0.75rem;overflow:hidden;margin-bottom:1rem;';
        thumb.className = isTriggerBook
          ? 'border-2 border-accent shadow-xl shadow-accent/20'
          : 'border border-white/10 shadow-lg';

        if (imgSrc) {
          const thumbImg = document.createElement('img');
          thumbImg.src = imgSrc;
          thumbImg.alt = '';
          thumbImg.loading = 'lazy';
          thumbImg.decoding = 'async';
          thumbImg.style.cssText = 'width:100%;height:100%;object-fit:cover;';
          thumb.appendChild(thumbImg);
        }

        card.appendChild(thumb);

        const label = document.createElement('span');
        label.className = 'text-lg font-medium text-center leading-snug text-white/90 group-hover/mini:text-white transition-colors line-clamp-2';
        label.style.cssText = 'display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;';
        label.textContent = title;
        card.appendChild(label);

        content.appendChild(card);
      });

      inner.appendChild(content);
      panel.appendChild(inner);

      document.body.appendChild(panel);

      if (!prefersReducedMotion()) {
        requestAnimationFrame(() => {
          requestAnimationFrame(() => {
            inner.style.transition = 'opacity 0.3s ease, transform 0.3s ease';
            inner.style.opacity = '1';
            inner.style.transform = 'scale(1)';
          });
        });
      }
    };

    const initializeCatalogSearch = () => {
      const searchInput = document.getElementById('catalog-search') as HTMLInputElement | null;
      const searchPanel = document.getElementById('catalog-search-panel');
      const resultCountStatus = document.getElementById('catalog-result-count');
      const resetButton = document.getElementById('catalog-search-reset') as HTMLButtonElement | null;

      if (!searchInput || searchInput.dataset.searchBound === 'true') return;

      searchInput.dataset.searchBound = 'true';
      if (resetButton) resetButton.dataset.searchBound = 'true';
      searchPanel?.classList.remove('hidden');

      const updateCatalog = () => {
        const cards = Array.from(document.querySelectorAll('.book-card-wrapper')) as HTMLElement[];
        const emptyState = document.getElementById('catalog-empty-state');
        const query = searchInput.value.toLowerCase().trim();
        let visibleCount = 0;

        closeSeriesPanel(false);

        cards.forEach((card) => {
          const title = card.getAttribute('data-title') || '';
          const author = card.getAttribute('data-author') || '';
          const series = card.getAttribute('data-series') || '';
          const isVisible = title.includes(query) || author.includes(query) || series.includes(query);

          card.hidden = !isVisible;
          if (isVisible) visibleCount += 1;
        });

        emptyState?.classList.toggle('hidden', !query || visibleCount > 0);
        if (resultCountStatus) resultCountStatus.textContent = query
          ? `Найдено книг: ${visibleCount} из ${cards.length}`
          : `Доступно книг: ${visibleCount} из ${cards.length}`;
      };

      searchInput.addEventListener('input', updateCatalog);
      resetButton?.addEventListener('click', () => {
        searchInput.value = '';
        updateCatalog();
        searchInput.focus();
      });
      updateCatalog();

      const catalog = document.getElementById('catalog');
      catalog?.addEventListener('click', (event) => {
        const target = event.target as HTMLElement;
        const trigger = target.closest('[data-series-trigger]') as HTMLElement | null;
        if (!trigger) return;

        event.preventDefault();
        event.stopPropagation();

        const seriesName = trigger.getAttribute('data-series-trigger');
        const wrapper = trigger.closest('.book-card-wrapper') as HTMLElement | null;
        if (!seriesName || !wrapper) return;

        const existingPanel = document.querySelector(`.${PANEL_CLASS}`) as HTMLElement | null;
        const isAlreadyOpen = existingPanel?.dataset.seriesName === seriesName &&
          existingPanel?.dataset.triggerId === wrapper.getAttribute('data-title');

        if (isAlreadyOpen) {
          closeSeriesPanel();
          return;
        }

        closeSeriesPanel(false).then(() => openSeriesPanel(seriesName, wrapper));
      });
    };

    if (!state.isBound) {
      state.isBound = true;
      document.addEventListener('astro:page-load', initializeCatalogSearch);
    }

    initializeCatalogSearch();
  </script>
</Layout>
