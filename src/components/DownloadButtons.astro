---
interface Props {
  colorEpub: string;
  bwEpub: string;
}

const { colorEpub, bwEpub } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<div class="grid gap-4 sm:grid-cols-2">
  <a
    href={colorEpub.startsWith('http') ? colorEpub : `${baseUrl}${colorEpub}`}
    data-donate-modal-trigger
    target="_blank"
    rel="noopener noreferrer"
    class="type-ui group relative block overflow-hidden rounded-xl border border-accent/55 bg-gradient-to-br from-accent via-[#d2a85b] to-[#6f461b] px-5 py-4 text-paper shadow-[0_18px_45px_rgba(176,138,69,0.34)] ring-1 ring-white/15 transition-all hover:-translate-y-1 hover:border-accent/80 hover:shadow-[0_24px_70px_rgba(228,213,183,0.36)]"
  >
    <div class="absolute inset-0 bg-white/20 opacity-0 transition-opacity group-hover:opacity-100"></div>
    <div class="relative flex items-center justify-between gap-4 transition-transform duration-300 group-hover:-translate-y-0.5">
      <div>
        <span class="block text-[0.68rem] font-black uppercase tracking-[0.24em] opacity-80">EPUB</span>
        <span class="mt-1 block text-sm font-black uppercase tracking-[0.18em]">Цветная версия</span>
      </div>
      <span class="flex h-10 w-10 items-center justify-center rounded-full bg-paper/95 text-xl text-ink shadow-lg transition-transform duration-300 group-hover:translate-x-1 group-hover:translate-y-1" aria-hidden="true">↓</span>
    </div>
  </a>

  <a
    href={bwEpub.startsWith('http') ? bwEpub : `${baseUrl}${bwEpub}`}
    data-donate-modal-trigger
    target="_blank"
    rel="noopener noreferrer"
    class="type-ui group relative block overflow-hidden rounded-xl border border-sky-200/40 bg-gradient-to-br from-white via-slate-500 to-slate-950 px-5 py-4 text-white shadow-[0_18px_45px_rgba(148,163,184,0.24)] ring-1 ring-white/10 transition-all hover:-translate-y-1 hover:border-sky-200/65 hover:shadow-[0_24px_70px_rgba(148,163,184,0.32)]"
  >
    <div class="absolute inset-0 bg-white/15 opacity-0 transition-opacity group-hover:opacity-100"></div>
    <div class="relative flex items-center justify-between gap-4 transition-transform duration-300 group-hover:-translate-y-0.5">
      <div>
        <span class="block text-[0.68rem] font-black uppercase tracking-[0.24em] opacity-75">EPUB</span>
        <span class="mt-1 block text-sm font-black uppercase tracking-[0.18em]">Ч/Б версия</span>
      </div>
      <span class="flex h-10 w-10 items-center justify-center rounded-full bg-white/95 text-xl text-slate-950 shadow-lg transition-transform duration-300 group-hover:translate-x-1 group-hover:translate-y-1" aria-hidden="true">↓</span>
    </div>
  </a>
</div>
