---
import { Image } from 'astro:assets';

interface Props {
  images: any[];
  hideHeader?: boolean;
}

const { images, hideHeader = false } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section class="w-full">
  {!hideHeader && (
    <div class="mb-4 flex items-end justify-between gap-6">
      <h2 class="text-lg font-bold leading-none tracking-tight">Иллюстрации</h2>
      <p class="type-ui text-[10px] font-black uppercase tracking-[0.24em] text-muted">{images?.length ?? 0} примера</p>
    </div>
  )}

  {images && images.length > 0 ? (
    <div class="grid grid-cols-2 gap-2">
      {images.map((img, index) => (
        <button
          type="button"
          class="group relative block aspect-[3/4] overflow-hidden rounded-md border border-white/10 bg-paper-alt cursor-zoom-in"
          data-lightbox-src={img.src}
          aria-label={`Увеличить иллюстрацию ${index + 1}`}
        >
          <Image
            src={img}
            alt={`Иллюстрация ${index + 1}`}
            width={400}
            format="webp"
            class="h-full w-full object-cover transition-all duration-700 group-hover:scale-105 group-hover:brightness-90"
            loading="lazy"
          />
          <span class="type-ui absolute left-3 top-3 bg-paper/90 px-2 py-1 text-[0.65rem] font-black uppercase tracking-[0.2em] text-ink opacity-0 transition-opacity group-hover:opacity-100 border border-ink/20">
            0{index + 1}
          </span>
        </button>
      ))}
    </div>
  ) : (
    <p class="text-muted italic">Иллюстрации не найдены.</p>
  )}
</section>
