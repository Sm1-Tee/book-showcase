---
import { Image } from 'astro:assets';

interface Props {
	title: string;
	author: string;
	coverImage: any;
	slug: string;
	series?: string;
	seriesOrder?: number;
	seriesCount?: number;
	imageLoading?: 'eager' | 'lazy';
	imageFetchPriority?: 'high' | 'low' | 'auto';
	imageSizes?: string;
}

const {
	title,
	author,
	coverImage,
	slug,
	series,
	seriesOrder,
	seriesCount,
	imageLoading = 'lazy',
	imageFetchPriority = 'auto',
	imageSizes = '(min-width: 1280px) 20vw, (min-width: 1024px) 25vw, (min-width: 640px) 33vw, 50vw',
} = Astro.props;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');

// На телефоне карточка узкая: длинные автор и название разъезжаются на много строк
// и растягивают всю строку ленты. Размер шрифта подбираем по длине текста при сборке,
// чтобы в браузере не было ни скриптов, ни пересчёта раскладки.
const authorSizeMobile =
	author.length <= 14 ? 'text-[13px]' :
	author.length <= 22 ? 'text-[12px]' :
	author.length <= 32 ? 'text-[11px]' : 'text-[10px]';

const titleSizeMobile =
	title.length <= 16 ? 'text-base' :
	title.length <= 28 ? 'text-[15px]' :
	title.length <= 40 ? 'text-[14px]' :
	title.length <= 55 ? 'text-[13px]' : 'text-[12px]';
---

<a href={`${baseUrl}/books/${slug}`} class="group flex h-full flex-col text-ink book-card" data-title={title.toLowerCase()} data-author={author.toLowerCase()} data-series={series?.toLowerCase() || ''}>
  <div class="relative aspect-[2/3] overflow-hidden rounded-md border border-white/10 md:shadow-lg transition-all duration-500 md:group-hover:-translate-y-2 md:group-hover:shadow-accent/20 md:group-hover:shadow-2xl">
    <div class="absolute inset-0 bg-gradient-to-t from-black/40 to-transparent z-10 opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none"></div>
    <Image
      src={coverImage}
      alt={`Обложка: ${title}`}
      width={640}
      height={960}
      class="hover-zoom-img h-full w-full object-cover"
      loading={imageLoading}
      decoding="async"
      sizes={imageSizes}
      fetchpriority={imageFetchPriority}
      format="webp"
      data-cover-slug={slug}
    />
    {series && seriesCount && seriesCount > 1 && (
      <span
        class="series-badge absolute bottom-2 left-2 right-2 z-20 rounded-lg border border-accent/30 bg-black/60 px-2 py-1.5 text-center text-[11px] font-bold uppercase tracking-wide text-accent backdrop-blur-sm transition-colors duration-200 hover:border-accent/50 hover:bg-black/70"
        data-series-trigger={series}
        role="button"
        tabindex="0"
      >
        {series}{seriesOrder ? ` #${seriesOrder}` : ''}
      </span>
    )}
  </div>

  <div class="mt-3 flex h-24 flex-none flex-col justify-start overflow-hidden text-center sm:mt-3.5 sm:h-auto sm:flex-1">
    <p class={`type-ui ${authorSizeMobile} font-black uppercase leading-tight tracking-[0.12em] text-accent hyphens-auto sm:text-[13px] sm:leading-normal sm:tracking-[0.14em]`}>{author}</p>
    <h3 class={`mt-1.5 ${titleSizeMobile} font-semibold leading-snug text-balance hyphens-auto transition-colors group-hover:text-accent sm:text-base`}>{title}</h3>
  </div>
</a>
