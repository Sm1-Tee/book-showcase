---
import { ClientRouter } from 'astro:transitions';
import { getCollection } from 'astro:content';
import '../styles/global.css';

interface Props {
	title: string;
	description?: string;
	ogImage?: string;
}

const {
	title,
	description = 'Галерея проиллюстрированных электронных книг',
	ogImage = '/images/donat.png'
} = Astro.props;
const siteUrl = Astro.site || Astro.url;
const baseUrl = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const withBaseUrl = (path: string) => {
	if (/^https?:\/\//.test(path) || path.startsWith(baseUrl)) return path;
	return `${baseUrl}${path.replace(/^\//, '')}`;
};
const canonicalHost = 'https://sm1-tee.github.io';
const canonicalPath = Astro.url.pathname.replace(/^\/chit-ai(?=\/|$)/, '') || '/';
const canonicalURL = new URL(canonicalPath, canonicalHost);
const fullOgImage = new URL(withBaseUrl(ogImage), siteUrl);
const totalBooks = (await getCollection('books')).length;
