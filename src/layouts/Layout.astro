			<div class="relative w-full max-w-lg rounded-[2rem] border border-white/12 bg-paper/90 sm:bg-paper/82 p-5 sm:p-8 text-center shadow-[0_28px_90px_rgba(0,0,0,0.62)] ring-1 ring-accent/18 backdrop-blur-md sm:backdrop-blur-2xl">
				<div class="absolute inset-x-8 -top-24 h-44 rounded-full bg-accent/18 blur-3xl" aria-hidden="true"></div>
				<button type="button" id="contact-modal-close" class="absolute right-3 top-3 sm:right-4 sm:top-4 z-10 inline-flex h-10 w-10 sm:min-h-12 sm:min-w-12 items-center justify-center rounded-full border border-white/12 bg-white/8 text-xl sm:text-2xl leading-none text-white transition-colors hover:border-accent/45 hover:text-accent focus:outline-none focus-visible:ring-2 focus-visible:ring-accent/50" aria-label="Закрыть окно связи">
					×
				</button>
				<div class="relative">
					<p class="type-ui mb-4 mx-auto max-w-[80%] text-[10px] sm:text-xs font-black uppercase tracking-[0.22em] text-accent">Есть вопросы или предложения?</p>
					<h2 id="contact-modal-title" class="text-2xl sm:text-3xl font-black tracking-[-0.03em] text-white">Связь с нами</h2>
					<p class="mx-auto mt-4 max-w-md text-base leading-7 text-white/90">Если у вас есть идеи для новых книг, вы нашли ошибку или хотите предложить сотрудничество — напишите нам.</p>
					<div class="mx-auto mt-6 flex w-full max-w-sm flex-col items-center gap-3 rounded-2xl border border-white/10 bg-black/40 p-4 sm:p-5 backdrop-blur-sm relative overflow-hidden sm:overflow-visible">
						<svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-accent/80" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
							<path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
						</svg>
						<button type="button" id="copy-email-btn" class="group flex w-full justify-center items-center gap-2 rounded-lg px-2 py-1 text-base sm:text-lg font-bold tracking-wide text-white transition-colors hover:text-accent focus:outline-none focus-visible:ring-2 focus-visible:ring-accent/50" aria-label="Скопировать адрес электронной почты">
							<span class="truncate">a.d3votee@gmail.com</span>
							<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 opacity-50 transition-opacity group-hover:opacity-100" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
								<path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
							</svg>
						</button>
						<div id="copy-toast" class="absolute bottom-2 left-1/2 -translate-x-1/2 translate-y-10 w-[90%] text-center rounded-full bg-emerald-500/90 px-3 py-1.5 text-[11px] sm:text-xs font-bold text-white opacity-0 shadow-lg backdrop-blur-md transition-all duration-300 pointer-events-none">
							Адрес скопирован!
						</div>
					</div>
					<div class="mt-6 grid gap-3">
						<a href="mailto:a.d3votee@gmail.com" class="type-ui inline-flex min-h-12 items-center justify-center rounded-full border border-emerald-300/45 bg-emerald-400/18 px-5 text-sm font-black uppercase text-emerald-100 shadow-lg shadow-emerald-500/20 ring-1 ring-emerald-300/20 transition-all hover:-translate-y-0.5 hover:border-emerald-200/70 hover:bg-emerald-300/25 hover:text-white focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-300/50">
							Написать письмо
						</a>
						<button type="button" id="contact-modal-dismiss" class="type-ui inline-flex min-h-12 items-center justify-center rounded-full border border-white/12 bg-white/8 px-5 text-sm font-black text-white transition-colors hover:border-accent/40 hover:text-accent focus:outline-none focus-visible:ring-2 focus-visible:ring-accent/50">
							Закрыть
						</button>
					</div>
				</div>
			</div>
		</dialog>

		<script>
			type ChitaiParticle = {
				x: number;
				y: number;
				vx: number;
				vy: number;
				size: number;
				baseAlpha: number;
				phase: number;
				pulse: number;
			};

			type ChitaiGlobalUiState = {
				isBound: boolean;
				reducedMotion: boolean;
				ambientBg: HTMLElement | null;
				canvas: HTMLCanvasElement | null;
				ctx: CanvasRenderingContext2D | null;
				width: number;
				height: number;
				particles: ChitaiParticle[];
				animationFrameId: number;
				parallaxFrameId: number;
				pointerX: number;
				pointerY: number;
				donatePreviousFocusedElement: HTMLElement | null;
			};

			const globalWindow = window as Window & typeof globalThis & {
				__chitaiGlobalUi?: ChitaiGlobalUiState;
			};

			const reducedMotionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
			const state = globalWindow.__chitaiGlobalUi ?? {
				isBound: false,
				reducedMotion: reducedMotionQuery.matches,
				ambientBg: null,
				canvas: null,
				ctx: null,
				width: window.innerWidth,
				height: window.innerHeight,
				particles: [],
				animationFrameId: 0,
				parallaxFrameId: 0,
				pointerX: 0,
				pointerY: 0,
				donatePreviousFocusedElement: null,
				contactPreviousFocusedElement: null,
			};
			globalWindow.__chitaiGlobalUi = state;

			const closeLightbox = () => {
				const lightbox = document.getElementById('lightbox');
				const lightboxImage = document.getElementById('lightbox-image') as HTMLImageElement | null;

				if (!lightbox || !lightboxImage) return;

				lightbox.classList.add('hidden');
				lightbox.classList.remove('flex');
				lightboxImage.src = '';
				document.body.style.overflow = '';
			};

			const donateFocusableSelector = 'a[href], button:not([disabled]), textarea:not([disabled]), input:not([disabled]), select:not([disabled]), [tabindex]:not([tabindex="-1"])';

			const initializeGlobalUi = () => {
				const donateModal = document.getElementById('donate-modal') as HTMLDialogElement | null;
				const contactModal = document.getElementById('contact-modal') as HTMLDialogElement | null;
				const lightbox = document.getElementById('lightbox') as HTMLElement | null;

			const createParticle = (): ChitaiParticle => ({
				x: Math.random() * state.width,
				y: Math.random() * state.height,
				vx: (Math.random() - 0.5) * 0.25,
				vy: (Math.random() - 0.5) * 0.25,
				size: Math.random() * 1.8 + 0.8, // Точки чуть больше
				baseAlpha: Math.random() * 0.45 + 0.2, // Точки заметно ярче
				phase: Math.random() * Math.PI * 2,
				pulse: Math.random() * 0.002 + 0.001,
			});

			const resizeCanvas = () => {
				state.width = window.innerWidth;
				state.height = window.innerHeight;

				if (!state.canvas) return;

				state.canvas.width = state.width;
				state.canvas.height = state.height;
			};

			const animateParticles = (time: number) => {
				const ctx = state.ctx;
				if (!ctx) return;

				ctx.clearRect(0, 0, state.width, state.height);

				const maxDistance = 150;
				const isMobile = state.width < 768;

				state.particles.forEach((particle, i) => {
					particle.x += particle.vx;
					particle.y += particle.vy;

					if (particle.x < 0) particle.x = state.width;
					if (particle.x > state.width) particle.x = 0;
					if (particle.y < 0) particle.y = state.height;
					if (particle.y > state.height) particle.y = 0;

					// Взаимодействие с курсором
					if (!isMobile && state.pointerX && state.pointerY) {
						const dx = state.pointerX - particle.x;
						const dy = state.pointerY - particle.y;
						const dist = Math.sqrt(dx * dx + dy * dy);
						if (dist < 180) {
							particle.x -= (dx / dist) * 0.5;
							particle.y -= (dy / dist) * 0.5;
						}
					}

					// Линии (созвездия)
					for (let j = i + 1; j < state.particles.length; j++) {
						const p2 = state.particles[j];
						const dx = particle.x - p2.x;
						const dy = particle.y - p2.y;
						const dist = Math.sqrt(dx * dx + dy * dy);

						if (dist < maxDistance) {
							ctx.beginPath();
							const lineOpacity = (1 - dist / maxDistance) * 0.45; // Линии ярче
							ctx.strokeStyle = `rgba(228, 213, 183, ${lineOpacity})`;
							ctx.lineWidth = 0.8;
							ctx.moveTo(particle.x, particle.y);
							ctx.lineTo(p2.x, p2.y);
							ctx.stroke();
						}
					}

					// Сама точка (без теней - чистая скорость)
					const alpha = particle.baseAlpha + Math.sin(time * particle.pulse + particle.phase) * 0.2;
					ctx.fillStyle = `rgba(228, 213, 183, ${alpha})`;
					ctx.beginPath();
					ctx.arc(particle.x, particle.y, particle.size, 0, Math.PI * 2);
					ctx.fill();
				});

				state.animationFrameId = requestAnimationFrame(animateParticles);
			};

			const closeMobileMenu = () => {
				const mobileMenu = document.getElementById('mobile-menu');
				const toggleButton = document.getElementById('mobile-menu-toggle');
				const iconOpen = document.getElementById('hamburger-icon-open');
				const iconClose = document.getElementById('hamburger-icon-close');

				if (!mobileMenu || mobileMenu.classList.contains('hidden')) return;

				mobileMenu.classList.add('hidden');
				toggleButton?.setAttribute('aria-expanded', 'false');
				toggleButton?.setAttribute('aria-label', 'Открыть меню');
				iconOpen?.classList.remove('hidden');
				iconClose?.classList.add('hidden');
			};

			const toggleMobileMenu = () => {
				const mobileMenu = document.getElementById('mobile-menu');
				const toggleButton = document.getElementById('mobile-menu-toggle');
				const iconOpen = document.getElementById('hamburger-icon-open');
				const iconClose = document.getElementById('hamburger-icon-close');

				if (!mobileMenu || !toggleButton) return;

				const isOpen = !mobileMenu.classList.contains('hidden');

				if (isOpen) {
					mobileMenu.classList.add('hidden');
					toggleButton.setAttribute('aria-expanded', 'false');
					toggleButton.setAttribute('aria-label', 'Открыть меню');
					iconOpen?.classList.remove('hidden');
					iconClose?.classList.add('hidden');
				} else {
					mobileMenu.classList.remove('hidden');
					toggleButton.setAttribute('aria-expanded', 'true');
					toggleButton.setAttribute('aria-label', 'Закрыть меню');
					iconOpen?.classList.add('hidden');
					iconClose?.classList.remove('hidden');
				}
			};

			const initializeGlobalUi = () => {
					closeLightbox();
					const donateModalEl = document.getElementById('donate-modal') as HTMLDialogElement | null;
					const contactModalEl = document.getElementById('contact-modal') as HTMLDialogElement | null;
					if (donateModalEl) donateModalEl.close();
					if (contactModalEl) contactModalEl.close();
					closeMobileMenu();
					document.querySelector('.series-panel')?.remove();

				state.reducedMotion = reducedMotionQuery.matches;
				state.ambientBg = document.querySelector('.ambient-bg') as HTMLElement | null;
				state.canvas = document.getElementById('bg-canvas') as HTMLCanvasElement | null;
				state.ctx = state.canvas?.getContext('2d') ?? null;
				resizeCanvas();

				if (state.animationFrameId) {
					cancelAnimationFrame(state.animationFrameId);
					state.animationFrameId = 0;
				}

				state.particles = [];

				// Полностью отключаем выполнение Canvas на мобильных телефонах
				const isMobile = state.width < 768;
				if (!state.canvas || !state.ctx || state.reducedMotion || isMobile) return;

				const density = 9000;
				const particleCount = Math.min(Math.floor(state.width * state.height / density), 100);
				for (let i = 0; i < particleCount; i++) state.particles.push(createParticle());

				state.animationFrameId = requestAnimationFrame(animateParticles);
			};

			if (!state.isBound) {
				state.isBound = true;

				document.addEventListener('click', (event) => {
					const target = event.target as HTMLElement | null;
					const trigger = target?.closest('[data-lightbox-src]') as HTMLElement | null;
						const donateTrigger = target?.closest('[data-donate-modal-trigger]') as HTMLElement | null;
						const donateModal = document.getElementById('donate-modal');
						const donateModalClose = document.getElementById('donate-modal-close');
						const donateModalDismiss = document.getElementById('donate-modal-dismiss');
						const contactTrigger = target?.closest('[data-contact-modal-trigger]') as HTMLElement | null;
						const contactModal = document.getElementById('contact-modal');
						const contactModalClose = document.getElementById('contact-modal-close');
						const contactModalDismiss = document.getElementById('contact-modal-dismiss');
						const copyEmailBtn = target?.closest('#copy-email-btn');
					const lightbox = document.getElementById('lightbox');
					const lightboxImage = document.getElementById('lightbox-image') as HTMLImageElement | null;
					const lightboxClose = document.getElementById('lightbox-close');

					const hamburgerToggle = target?.closest('#mobile-menu-toggle');
					if (hamburgerToggle) {
						toggleMobileMenu();
						return;
					}

					if (trigger && lightbox && lightboxImage) {
						lightboxImage.src = trigger.dataset.lightboxSrc || '';
						lightbox.classList.remove('hidden');
						lightbox.classList.add('flex');
						document.body.style.overflow = 'hidden';
					}

					if (donateTrigger) {
						const modal = document.getElementById('donate-modal') as HTMLDialogElement | null;
						if (modal) {
							modal.showModal();
							document.body.style.overflow = 'hidden';
						}
					}
					if (contactTrigger) {
						const modal = document.getElementById('contact-modal') as HTMLDialogElement | null;
						if (modal) {
							modal.showModal();
							document.body.style.overflow = 'hidden';
						}
					}

					if (copyEmailBtn) {
						navigator.clipboard.writeText('a.d3votee@gmail.com').then(() => {
							const toast = document.getElementById('copy-toast');
							if (toast) {
								toast.classList.remove('opacity-0', 'translate-y-10');
								toast.classList.add('opacity-100', 'translate-y-0');
								setTimeout(() => {
									toast.classList.remove('opacity-100', 'translate-y-0');
									toast.classList.add('opacity-0', 'translate-y-10');
								}, 2500);
							}
						});
					}

						if (donateModal && target === donateModal) {
							(donateModal as HTMLDialogElement).close();
							document.body.style.overflow = '';
						}
						if (contactModal && target === contactModal) {
							(contactModal as HTMLDialogElement).close();
							document.body.style.overflow = '';
						}
						if (target.closest('#donate-modal-close') || target.closest('#donate-modal-dismiss')) {
							const modal = document.getElementById('donate-modal') as HTMLDialogElement | null;
							if (modal) {
								modal.close();
								document.body.style.overflow = '';
							}
						}
						if (target.closest('#contact-modal-close') || target.closest('#contact-modal-dismiss')) {
							const modal = document.getElementById('contact-modal') as HTMLDialogElement | null;
							if (modal) {
								modal.close();
								document.body.style.overflow = '';
							}
						}
						if (target === lightbox || target === lightboxClose) closeLightbox();
				});

				

				
					const donateModal = document.getElementById('donate-modal') as HTMLDialogElement | null;
					const contactModal = document.getElementById('contact-modal') as HTMLDialogElement | null;

					if (donateModal) donateModal.addEventListener('close', () => document.body.style.overflow = '');
					if (contactModal) contactModal.addEventListener('close', () => document.body.style.overflow = '');

				window.addEventListener('mousemove', (event) => {
					if (!state.ambientBg || state.reducedMotion) return;

					state.pointerX = event.clientX;
					state.pointerY = event.clientY;

					if (state.parallaxFrameId) return;

					state.parallaxFrameId = requestAnimationFrame(() => {
						const x = (state.pointerX / window.innerWidth - 0.5) * 40;
						const y = (state.pointerY / window.innerHeight - 0.5) * 40;

						state.ambientBg?.style.setProperty('--mouse-x', `${x}px`);
						state.ambientBg?.style.setProperty('--mouse-y', `${y}px`);
						state.parallaxFrameId = 0;
					});
				});

				window.addEventListener('resize', resizeCanvas);
				reducedMotionQuery.addEventListener('change', initializeGlobalUi);
				document.addEventListener('astro:page-load', initializeGlobalUi);

				const scrollToTopBtn = document.getElementById('scroll-to-top');

				const toggleScrollBtn = () => {
					if (!scrollToTopBtn) return;
					if (window.scrollY > 500) {
						scrollToTopBtn.classList.remove('opacity-0', 'translate-y-20', 'pointer-events-none');
						scrollToTopBtn.classList.add('opacity-100', 'translate-y-0');
					} else {
						scrollToTopBtn.classList.add('opacity-0', 'translate-y-20', 'pointer-events-none');
						scrollToTopBtn.classList.remove('opacity-100', 'translate-y-0');
					}
				};

				window.addEventListener('scroll', toggleScrollBtn, { passive: true });

				scrollToTopBtn?.addEventListener('click', () => {
					window.scrollTo({ top: 0, behavior: 'smooth' });
				});
			}

			}

			initializeGlobalUi();
		</script>
	</body>
</html>
